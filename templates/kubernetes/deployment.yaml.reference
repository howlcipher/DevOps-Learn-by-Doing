# Reference Kubernetes manifest for module_05_kubernetes_overview and the
# later hands-on Kubernetes modules. Not applied by any tool in V1.

apiVersion: apps/v1
kind: Deployment
metadata:
  name: api-platform
  labels:
    app: api-platform
spec:
  replicas: 2
  selector:
    matchLabels:
      app: api-platform
  template:
    metadata:
      labels:
        app: api-platform
    spec:
      # Pod-level identity: the image already builds a non-root user, and this
      # makes the cluster refuse to start it if that ever regresses.
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: api-platform
          image: api-platform:latest
          ports:
            - containerPort: 8000
          env:
            - name: ENVIRONMENT
              value: "production"
          # Least privilege for the container process: no privilege escalation,
          # no Linux capabilities, and an immutable root filesystem.
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          # Requests drive scheduling; limits stop one workload starving the node.
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              cpu: 500m
              memory: 256Mi
          readinessProbe:
            httpGet:
              path: /health
              port: 8000
            initialDelaySeconds: 3
            periodSeconds: 5
          livenessProbe:
            httpGet:
              path: /health
              port: 8000
            initialDelaySeconds: 10
            periodSeconds: 15
---
apiVersion: v1
kind: Service
metadata:
  name: api-platform
spec:
  selector:
    app: api-platform
  ports:
    - port: 80
      targetPort: 8000
  type: ClusterIP
