# Copy to .env and fill in only if you want the real Anthropic tutor provider.
# The platform runs fully in simulation mode with zero credentials by default.

# Optional: enables AnthropicProvider instead of MockLLMProvider.
ANTHROPIC_API_KEY=

# Optional: overrides the sqlite database location.
# Defaults to ~/.devops_learn/learning.db
DEVOPS_LEARN_DB_PATH=
